# Ghostty's Zig package cache, built from the pinned Ghostty source.
#
# Ghostty ships `build.zig.zon.nix` (generated by zon2nix) for exactly this:
# every Zig dependency becomes a fixed-output fetch, so the Halyard build itself
# never touches the network. The result is handed to libghostty-vt-sys through
# GHOSTTY_ZIG_SYSTEM_DIR, which makes it run `zig build --system <dir>`.
#
# Ghostty's own nix/libghostty-vt.nix replaces `linkFarm` with a copy farm,
# because Zig's build runner computes relative paths lexically and goes wrong
# when a package directory is a symlink into the store
# (https://codeberg.org/ziglang/zig/issues/32121). We do the same.
{
  pkgs,
  ghosttySrc,
}:
pkgs.callPackage "${ghosttySrc}/build.zig.zon.nix" {
  name = "ghostty-zig-packages";
  linkFarm =
    name: entries:
    pkgs.runCommand name { } ''
      mkdir -p "$out"
      ${pkgs.lib.concatMapStringsSep "\n" (e: ''cp -rL "${e.path}" "$out/${e.name}"'') entries}
    '';
}
